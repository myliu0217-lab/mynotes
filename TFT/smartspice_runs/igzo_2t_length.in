* IGZO 2T length sweep; model is the user-specified MY_W600L10 card.
.LIB 'C:\Users\12508\Documents\xwechat_files\wxid_ncy6a4tna08y11_7cd8\msg\file\2026-06\NVO_TFT Modelcard.LIB' NVOTFT
.MODEL MY_W600L10 NTFT (
+LAMBDA=0.0497989 LEVEL=36 VERSION=2 TNOM=27 TOX=1.03577e-07 VTO=10
+VFB=0 VON=0 DVT=0 VKINK=10 VSI=6.24934 VST=10
+MU1=0.1 MMU=1.02429 MU0=21.2225 MK=2 MUS=2 RD=100 RS=100
+BT=5.82535e-05 BLK=1e-08 DD=2.93579e-06 DELTA=2.8843 DG=6.43138e-07
+EB=0.640753 ETA=1.65606 I0=17.2082 I00=10 ASAT=1.6111 AT=6.17753e-09
+DASAT=0 LASAT=3.16543e-06 LKINK=1e-09 DVTO=0 DMU1=0 CAPMOD=0
+CGSO=1.31e-13 CGDO=1.31e-13 ETAC00=0 MC=3 RDX=0 RSX=0
+ZEROC=0 ME=2.5 MSS=1.5 THETA=0 ISUBMOD=0 INTSDNOD=0 SCALERPI=0 )

.TEMP 27
.OPTIONS RELTOL=1e-4 POST=2 LIST SAVEMEASUREOUT
.PARAM WS=800u LS=10u WR=100u LR=10u RFVAL=330k CFVAL=1n

VIN     gate 0 DC 0 AC 1
VD      vd   0 DC 12
VROW    row  0 DC 20
VREF    ref  0 DC -5.2
MSEL    vd row nd MY_W600L10 W='WR' L='LR'
MAMP    nd gate ns MY_W600L10 W='WS' L='LS'
VSENSE  ns sum DC 0
EAMP    out 0 ref sum 1e6
RF      out sum 'RFVAL'
CF      out sum 'CFVAL'

.DATA LGEOM LS LR
+ 5u  5u
+ 5u  10u
+ 5u  15u
+ 5u  20u
+ 10u 5u
+ 10u 10u
+ 10u 15u
+ 10u 20u
+ 15u 5u
+ 15u 10u
+ 15u 15u
+ 15u 20u
+ 20u 5u
+ 20u 10u
+ 20u 15u
+ 20u 20u
.ENDDATA

.DC VIN 0 0 1 SWEEP DATA=LGEOM
.PRINT DC V(nd) V(out) I(VSENSE)
+ @MAMP[GM] @MAMP[GDS] @MSEL[GM] @MSEL[GDS]

.AC DEC 40 1 100k SWEEP DATA=LGEOM
.MEASURE AC AV10 FIND VM(out) AT=10
.MEASURE AC GMEFF10 PARAM='AV10/RFVAL'
.MEASURE AC F3DB WHEN VM(out)='AV10*0.70710678'

.NOISE V(out) VIN DEC 40 1 100k SWEEP DATA=LGEOM
.PRINT NOISE INOISE ONOISE
.END
